import { useEffect, useState } from "react";
import {
  ArrowLeft,
  Users,
  UserCheck,
  UserX,
  RefreshCw,
} from "lucide-react";
import { useNavigate } from "react-router-dom";
import {
  getActiveCampaigns,
  getChurnSummary,
  getCustomerSummary,
} from "../services/dashboardApi";

import "../styles/CustomerIntelligence.css";

function CustomerSegmentation() {
  const navigate = useNavigate();
  const [customerSummary, setCustomerSummary] = useState(null);
  const [churnSummary, setChurnSummary] = useState(null);
  const [campaignData, setCampaignData] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [reloadKey, setReloadKey] = useState(0);

  useEffect(() => {
    let isCurrentRequest = true;

    const loadSegments = async () => {
      setLoading(true);
      setError("");

      const [customerResult, churnResult, campaignResult] =
        await Promise.allSettled([
          getCustomerSummary(),
          getChurnSummary(),
          getActiveCampaigns(),
        ]);

      if (!isCurrentRequest) return;

      setCustomerSummary(
        customerResult.status === "fulfilled" ? customerResult.value : null
      );
      setChurnSummary(
        churnResult.status === "fulfilled" ? churnResult.value : null
      );
      setCampaignData(
        campaignResult.status === "fulfilled" ? campaignResult.value : null
      );

      if (customerResult.status === "rejected" && churnResult.status === "rejected") {
        setError("Customer and churn segment data could not be loaded.");
      }
      setLoading(false);
    };

    loadSegments();
    return () => {
      isCurrentRequest = false;
    };
  }, [reloadKey]);

  const riskCounts = churnSummary?.risk_tier_counts || {};
  const countFor = (tier) =>
    Number(riskCounts[tier] ?? riskCounts[tier[0].toUpperCase() + tier.slice(1)] ?? 0);
  const highCount = countFor("high");
  const mediumCount = countFor("medium");
  const lowCount = countFor("low");
  const scoredCustomers = Number(churnSummary?.scored_customers) || 0;
  const totalCustomers = Number(customerSummary?.total_customers) || 0;
  const atRiskCustomers = highCount + mediumCount;
  const thresholds = churnSummary?.risk_thresholds || {};
  const formatCount = (value) => Number(value || 0).toLocaleString("en-US");
  const formatPercent = (value) => {
    if (value === null || value === undefined || !Number.isFinite(Number(value))) {
      return "threshold unavailable";
    }
    return `${(Number(value) * 100).toFixed(0)}%`;
  };

  const segments = [
    {
      key: "high",
      name: "High Risk",
      count: highCount,
      description: `Churn probability at or above ${formatPercent(thresholds.high)}.`,
      tone: "risk-high",
    },
    {
      key: "medium",
      name: "Medium Risk",
      count: mediumCount,
      description: `Churn probability from ${formatPercent(thresholds.medium)} to below ${formatPercent(thresholds.high)}.`,
      tone: "risk-medium",
    },
    {
      key: "low",
      name: "Low Risk",
      count: lowCount,
      description: `Churn probability below ${formatPercent(thresholds.medium)}.`,
      tone: "risk-low",
    },
  ];

  const campaigns = Array.isArray(campaignData?.campaigns)
    ? campaignData.campaigns
    : [];

  return (
    <div className="ci-page">

      {/* HEADER */}

      <div className="ci-detail-header">

        <div className="ci-header-left">

          <button
            className="ci-back-button"
            onClick={() => window.history.back()}
          >
            <ArrowLeft size={18} />
          </button>

          <div>
            <h1>Customer Segmentation</h1>

            <p>
              View segments, insights and campaign
              recommendations.
            </p>
          </div>

        </div>

        <button
          className="ci-primary-button"
          type="button"
          onClick={() => navigate("/churn-prediction?risk_tier=high")}
        >
          <UserX size={17} />
          Review High Risk
        </button>

      </div>

      {/* STAT CARDS */}

      <div className="ci-stat-grid">

        <div className="ci-stat-card">

          <div className="ci-stat-icon purple">
            <Users size={22} />
          </div>

          <div>
            <span>Total Segments</span>
            <strong>{segments.length}</strong>
          </div>

        </div>

        <div className="ci-stat-card">

          <div className="ci-stat-icon blue">
            <UserCheck size={22} />
          </div>

          <div>
            <span>Total Customers</span>
            <strong>
              {loading
                ? "…"
                : customerSummary
                  ? formatCount(totalCustomers)
                  : "—"}
            </strong>
          </div>

        </div>

        <div className="ci-stat-card">

          <div className="ci-stat-icon red">
            <UserX size={22} />
          </div>

          <div>
            <span>At Risk Customers</span>
            <strong>
              {loading
                ? "…"
                : churnSummary
                  ? formatCount(atRiskCustomers)
                  : "—"}
            </strong>
          </div>

        </div>

      </div>

      {/* SEGMENT TABLE */}

      <div className="ci-card">

        <div className="ci-segment-card-header">
          <div>
            <h2>Churn Risk Segments</h2>
            <p>
              {churnSummary
                ? `${formatCount(scoredCustomers)} customers with a current model score`
                : "Model score totals unavailable"}
            </p>
          </div>
          <button
            type="button"
            className="ci-segment-refresh"
            onClick={() => setReloadKey((key) => key + 1)}
            disabled={loading}
            aria-label="Refresh segmentation data"
          >
            <RefreshCw size={16} className={loading ? "ci-spin" : ""} />
            Refresh
          </button>
        </div>

        {error && (
          <div className="ci-segment-error" role="alert">
            {error}
            <button type="button" onClick={() => setReloadKey((key) => key + 1)}>
              Try again
            </button>
          </div>
        )}

        {loading ? (
          <div className="ci-segment-loading">
            <RefreshCw size={22} className="ci-spin" />
            Loading live segment data...
          </div>
        ) : churnSummary ? (

        <div className="ci-table-wrapper">

          <table className="ci-table">

            <thead>
              <tr>
                <th>Segment</th>
                <th>No. of Customers</th>
                <th>Description</th>
                <th>Action</th>
              </tr>
            </thead>

            <tbody>

              {segments.map((segment) => (

                <tr key={segment.name}>

                  <td>
                    <strong className={segment.tone}>
                      {segment.name}
                    </strong>
                  </td>

                  <td>
                    {formatCount(segment.count)}
                  </td>

                  <td>
                    <span className="ci-segment-description">
                      {segment.description}
                    </span>
                  </td>

                  <td>

                    <button
                      className="ci-view-button"
                      type="button"
                      onClick={() =>
                        navigate(`/churn-prediction?risk_tier=${segment.key}`)
                      }
                    >
                      View customers
                    </button>

                  </td>

                </tr>

              ))}

            </tbody>

          </table>

        </div>

        ) : (
          <div className="ci-segment-error">
            Churn risk segments are unavailable because no model summary was returned.
          </div>
        )}

      </div>

      <section className="ci-card ci-campaign-segment-card">
        <div className="ci-segment-card-header">
          <div>
            <h2>Active Campaigns</h2>
            <p>Campaigns returned by the backend recommendation data</p>
          </div>
          <span className="ci-campaign-count">
            {loading
              ? "…"
              : campaignData
                ? `${formatCount(Number(campaignData.active_campaigns) || campaigns.length)} active`
                : "Unavailable"}
          </span>
        </div>

        {campaigns.length > 0 ? (
          <div className="ci-active-campaigns">
            {campaigns.map((campaign, index) => (
              <article
                className="ci-active-campaign"
                key={campaign?.campaign_name || index}
              >
                <div>
                  <h3>{campaign?.campaign_name || "Campaign"}</h3>
                  <p>{formatCount(campaign?.customer_count)} targeted customers</p>
                </div>
                <span>
                  {campaign?.average_priority !== null && campaign?.average_priority !== undefined
                    ? `Priority ${Number(campaign.average_priority).toFixed(1)}`
                    : "Priority unavailable"}
                </span>
              </article>
            ))}
          </div>
        ) : (
          <div className="ci-segment-empty">
            {loading
              ? "Loading campaigns..."
              : campaignData
                ? "No active campaigns were returned."
                : "Campaign recommendations are unavailable."}
          </div>
        )}
      </section>

    </div>
  );
}

export default CustomerSegmentation;
