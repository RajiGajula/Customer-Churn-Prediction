import { useEffect, useState } from "react";
import {
  LayoutDashboard,
  LogOut,
  Package,
  ShoppingBag,
  Store,
  User,
} from "lucide-react";
import { NavLink, useNavigate } from "react-router-dom";

import { getCustomerProfile } from "../services/authApi";
import { getOrders } from "../services/ordersApi";
import CustomerOrderDialog from "../components/CustomerOrderDialog";
import "../styles/Dashboard.css";
import "../styles/CustomerDashboard.css";

const sidebarItems = [
  { label: "Overview", path: "/dashboard", icon: LayoutDashboard },
  { label: "Orders", path: "/orders", icon: ShoppingBag },
  { label: "Products", path: "/products", icon: Package },
  { label: "Sellers", path: "/sellers", icon: Store },
  { label: "My Account", path: "/profile", icon: User },
];

function formatDate(value) {
  if (!value) return "—";
  const date = new Date(value);
  return Number.isNaN(date.getTime())
    ? value
    : date.toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    });
}

function CustomerDashboard() {
  const navigate = useNavigate();
  const [profile, setProfile] = useState(null);
  const [orders, setOrders] = useState([]);
  const [totalOrders, setTotalOrders] = useState(0);
  const [profileLoading, setProfileLoading] = useState(true);
  const [ordersLoading, setOrdersLoading] = useState(true);
  const [profileError, setProfileError] = useState("");
  const [ordersError, setOrdersError] = useState("");
  const [showLogoutConfirmation, setShowLogoutConfirmation] = useState(false);
  const [showPlaceOrder, setShowPlaceOrder] = useState(false);

  useEffect(() => {
    let active = true;
    getCustomerProfile()
      .then((customerProfile) => {
        if (active) setProfile(customerProfile);
      })
      .catch((loadError) => {
        if (active) setProfileError(loadError.message || "Unable to load your profile.");
      })
      .finally(() => {
        if (active) setProfileLoading(false);
      });
    getOrders({ sortBy: "new", sortDirection: "desc", page: 1, limit: 5 })
      .then((orderResult) => {
        if (!active) return;
        setOrders(orderResult?.data || []);
        setTotalOrders(Number(orderResult?.total || 0));
      })
      .catch((loadError) => {
        if (active) setOrdersError(loadError.message || "Unable to load your orders.");
      })
      .finally(() => {
        if (active) setOrdersLoading(false);
      });

    return () => {
      active = false;
    };
  }, []);

  const handleLogout = () => {
    ["user", "currentUser", "loggedInUser", "userData", "access_token", "token", "name", "role"]
      .forEach((key) => localStorage.removeItem(key));
    navigate("/login", { replace: true });
  };

  return (
    <div className="dashboard-app customer-dashboard-app">
      <aside className="dashboard-sidebar">
        <div className="sidebar-logo">
          <div className="logo-circle" />
          <div className="logo-text"><strong>CUSTOMER</strong><strong>SPHERE</strong></div>
        </div>
        <nav className="sidebar-navigation" aria-label="Main navigation">
          {sidebarItems.map(({ label, path, icon: Icon }) => (
            <NavLink
              key={path}
              to={path}
              className={({ isActive }) => isActive ? "sidebar-item active" : "sidebar-item"}
            >
              <Icon size={23} />
              <span>{label}</span>
            </NavLink>
          ))}
        </nav>
        <button className="customer-dashboard-logout" onClick={() => setShowLogoutConfirmation(true)} type="button">
          <LogOut size={18} />
          <span>Sign out</span>
        </button>
      </aside>

      <main className="customer-dashboard-main">
        <header className="customer-dashboard-header">
          <div>
            <span className="customer-dashboard-eyebrow">Customer portal</span>
            <h1>Welcome, {profile?.name || localStorage.getItem("name") || "Customer"}</h1>
            <p>Your profile, orders, and delivery updates in one place.</p>
          </div>
          <div className="customer-dashboard-header-actions">
            <button type="button" className="customer-dashboard-place-order" onClick={() => setShowPlaceOrder(true)}>
              <ShoppingBag size={18} /> Place an order
            </button>
          </div>
        </header>

        <div className="customer-dashboard-content">
            <section className="customer-dashboard-cards" aria-label="Your customer summary">
              <article className="customer-summary-card profile">
                <span>Your profile</span>
                {profileLoading ? (
                  <p className="customer-dashboard-message" role="status">Loading profile…</p>
                ) : profileError ? (
                  <p className="customer-dashboard-error" role="alert">{profileError}</p>
                ) : (
                  <>
                    <h2>{profile.name}</h2>
                    <dl>
                      <div><dt>Email</dt><dd>{profile.email || "—"}</dd></div>
                      <div><dt>Phone</dt><dd>{profile.phone || "—"}</dd></div>
                      <div><dt>Address</dt><dd>{[profile.address, profile.city, profile.state].filter(Boolean).join(", ") || "—"}</dd></div>
                    </dl>
                  </>
                )}
              </article>
              <article className="customer-summary-card orders">
                <span>Your orders</span>
                <strong>{ordersLoading ? "—" : totalOrders}</strong>
                <p>Orders linked to your customer profile</p>
                <button type="button" onClick={() => navigate("/orders")}>View and manage orders</button>
              </article>
            </section>

            <section className="customer-recent-orders">
              <div className="customer-recent-orders-heading">
                <div>
                  <span className="customer-dashboard-eyebrow">Order activity</span>
                  <h2>Recent orders</h2>
                </div>
                <button type="button" onClick={() => navigate("/orders")}>All orders</button>
              </div>
              {ordersLoading ? (
                <p className="customer-dashboard-message" role="status">Loading recent orders…</p>
              ) : ordersError ? (
                <p className="customer-dashboard-error" role="alert">{ordersError}</p>
              ) : orders.length ? (
                <div className="customer-recent-orders-list">
                  {orders.map((order) => (
                    <article className="customer-recent-order" key={order.order_id}>
                      <div>
                        <strong>Order {order.order_id}</strong>
                        <span>Placed {formatDate(order.order_purchase_timestamp)}</span>
                      </div>
                      <span className={`customer-order-status ${String(order.order_status || "").toLowerCase()}`}>
                        {String(order.order_status || "unknown").replaceAll("_", " ")}
                      </span>
                      <button
                        type="button"
                        onClick={() => navigate(`/orders?search=${encodeURIComponent(order.order_id)}`)}
                      >
                        Order details & actions
                      </button>
                    </article>
                  ))}
                </div>
              ) : (
                <p className="customer-dashboard-empty">No orders are linked to your profile yet.</p>
              )}
              <p className="customer-order-help">
                From order details, you can cancel before shipment, confirm delivery when it arrives,
                and leave feedback once delivery is confirmed.
              </p>
            </section>
        </div>
      </main>
      {showLogoutConfirmation && (
        <div className="customer-logout-overlay" role="presentation">
          <section className="customer-logout-dialog" role="alertdialog" aria-modal="true" aria-labelledby="customer-logout-title">
            <h2 id="customer-logout-title">Sign out?</h2>
            <p>Are you sure you want to sign out of Customer Sphere?</p>
            <div>
              <button type="button" className="customer-logout-cancel" onClick={() => setShowLogoutConfirmation(false)}>
                Cancel
              </button>
              <button type="button" className="customer-logout-confirm" onClick={handleLogout}>
                Sign out
              </button>
            </div>
          </section>
        </div>
      )}
      {showPlaceOrder && (
        <CustomerOrderDialog
          initialProfile={profile}
          onClose={() => setShowPlaceOrder(false)}
          onCreated={() => {
            setShowPlaceOrder(false);
            navigate("/orders");
          }}
        />
      )}
    </div>
  );
}

export default CustomerDashboard;
