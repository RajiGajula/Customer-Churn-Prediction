import { useEffect, useState } from "react";
import { useSearchParams } from "react-router-dom";
import {
  Search,
  ChevronLeft,
  ChevronRight,
  User,
  ArrowLeft,
  RefreshCw,
} from "lucide-react";

import "../styles/CustomerIntelligence.css";

const API_URL =
  import.meta.env.VITE_API_URL || "http://127.0.0.1:8000";

function ChurnPrediction() {
  const [search, setSearch] = useState("");
  const [searchQuery, setSearchQuery] = useState("");
  const [searchParams] = useSearchParams();
  const [activeTab, setActiveTab] = useState(() => {
    const tier = searchParams.get("risk_tier");
    return tier === "high"
      ? "High Risk"
      : tier === "medium"
        ? "At Risk"
        : tier === "low"
          ? "Low Risk"
          : "All Customers";
  });

  const [customers, setCustomers] = useState([]);
  const [totalCustomers, setTotalCustomers] = useState(0);
  const [totalPages, setTotalPages] = useState(0);
  const [page, setPage] = useState(1);
  const [reloadKey, setReloadKey] = useState(0);

  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  // =========================================================
  // GET AUTH TOKEN
  // =========================================================

  const getToken = () => {
    return (
      localStorage.getItem("access_token") ||
      localStorage.getItem("token")
    );
  };

  useEffect(() => {
    const controller = new AbortController();
    let isCurrentRequest = true;

    const loadCustomers = async () => {
      setLoading(true);
      setError("");

      const params = new URLSearchParams({
        min_probability: "0",
        page: String(page),
        limit: "20",
      });

      const riskTier = {
        "High Risk": "high",
        "At Risk": "medium",
        "Low Risk": "low",
      }[activeTab];

      if (riskTier) params.set("risk_tier", riskTier);
      if (searchQuery) params.set("search", searchQuery);

      try {
        const token = getToken();
        const response = await fetch(
          `${API_URL}/api/v1/atrisk?${params.toString()}`,
          {
            method: "GET",
            signal: controller.signal,
            headers: {
              "Content-Type": "application/json",
              ...(token ? { Authorization: `Bearer ${token}` } : {}),
            },
          }
        );
        const data = await response.json();

        if (!response.ok) {
          throw new Error(
            data.detail || "Unable to load churn prediction data."
          );
        }

        if (!isCurrentRequest) return;
        setCustomers(Array.isArray(data.data) ? data.data : []);
        setTotalCustomers(Number(data.total) || 0);
        setTotalPages(Number(data.total_pages) || 0);
      } catch (err) {
        if (err.name === "AbortError" || !isCurrentRequest) return;
        setCustomers([]);
        setTotalCustomers(0);
        setTotalPages(0);
        setError(err.message || "Unable to load churn prediction data.");
      } finally {
        if (isCurrentRequest) setLoading(false);
      }
    };

    loadCustomers();
    return () => {
      isCurrentRequest = false;
      controller.abort();
    };
  }, [activeTab, page, reloadKey, searchQuery]);

  const filteredCustomers = customers;

  const handleSearch = (event) => {
    event.preventDefault();
    setPage(1);
    setSearchQuery(search.trim());
  };

  const handleTabChange = (tab) => {
    setActiveTab(tab);
    setPage(1);
  };

  const formatProbability = (probability) => {
    if (probability === null || probability === undefined) return "N/A";
    const value = Number(probability);
    return Number.isFinite(value) ? `${(value * 100).toFixed(1)}%` : "N/A";
  };

  const formatDate = (date) => {
    if (!date) return "N/A";
    const parsedDate = new Date(date);
    if (Number.isNaN(parsedDate.getTime())) return "N/A";
    return parsedDate.toLocaleDateString("en-US", {
      day: "2-digit",
      month: "short",
      year: "numeric",
    });
  };

  // =========================================================
  // STATUS CLASS
  // =========================================================

  const getStatusClass = (customer) => {
    const status =
      customer.status || "";

    const riskTier =
      customer.risk_tier || "";

    if (
      status === "High Risk" ||
      riskTier === "high"
    ) {
      return "ci-status risk";
    }

    if (
      status === "At Risk" ||
      riskTier === "medium"
    ) {
      return "ci-status risk";
    }

    return "ci-status safe";
  };

  // =========================================================
  // OPEN CUSTOMER DETAILS
  // =========================================================

  const openCustomerDetails = (
    customerId
  ) => {
    if (!customerId) {
      return;
    }

    window.location.href =
      `/customer-details/${encodeURIComponent(
        customerId
      )}`;
  };

  // =========================================================
  // RENDER
  // =========================================================

  return (
    <div className="ci-page">

      {/* ================================================= */}
      {/* HEADER */}
      {/* ================================================= */}

      <div className="ci-page-header">

        <div>

          <button
            className="ci-back-button"
            onClick={() =>
              window.history.back()
            }
            type="button"
          >
            <ArrowLeft size={18} />
          </button>

          <div className="ci-title-wrapper">

            <h1>
              Churn Prediction
            </h1>

            <p>
              View customers with real
              churn prediction results
              and take action.
            </p>

          </div>

        </div>

      </div>

      {/* ================================================= */}
      {/* MAIN CARD */}
      {/* ================================================= */}

      <div className="ci-card">

        {/* ================================================= */}
        {/* SEARCH + FILTER */}
        {/* ================================================= */}

        <form className="ci-search-row" onSubmit={handleSearch}>
          <div className="ci-search">
            <button
              className="ci-search-submit"
              type="submit"
              aria-label="Search predictions"
            >
              <Search size={19} />
            </button>
            <input
              type="search"
              placeholder="Search by customer ID prefix..."
              value={search}
              onChange={(event) => setSearch(event.target.value)}
            />
          </div>

          <button
            className="ci-filter-button"
            type="button"
            onClick={() => setReloadKey((key) => key + 1)}
            disabled={loading}
          >
            <RefreshCw
              size={16}
              className={loading ? "ci-spin" : ""}
            />
            Refresh
          </button>
        </form>

        {/* ================================================= */}
        {/* TABS */}
        {/* ================================================= */}

        <div className="ci-tabs">

          {[
            "All Customers",
            "High Risk",
            "At Risk",
            "Low Risk",
          ].map((tab) => (

            <button
              key={tab}
              type="button"
              className={
                activeTab === tab
                  ? "ci-tab active"
                  : "ci-tab"
              }
              onClick={() => handleTabChange(tab)}
            >
              {tab}
            </button>

          ))}

        </div>

        {/* ================================================= */}
        {/* ERROR */}
        {/* ================================================= */}

        {error && (
          <div className="ci-error-message" role="alert">
            <strong>Unable to load churn predictions</strong>
            <p>{error}</p>
            <button
              type="button"
              onClick={() => setReloadKey((key) => key + 1)}
            >
              Try again
            </button>
          </div>
        )}

        {/* ================================================= */}
        {/* LOADING */}
        {/* ================================================= */}

        {loading && (

          <div
            style={{
              padding: "50px",
              textAlign: "center",
            }}
          >
            <RefreshCw
              size={28}
              className="ci-spin"
            />

            <p>
              Loading churn
              predictions...
            </p>

          </div>

        )}

        {/* ================================================= */}
        {/* TABLE */}
        {/* ================================================= */}

        {!loading && !error && (
          <>
          <div className="ci-table-wrapper">

            <table className="ci-table">

              <thead>

                <tr>

                  <th>
                    Customer
                  </th>

                  <th>
                    Churn Probability
                  </th>

                  <th>
                    Churn Status
                  </th>

                  <th>
                    Location
                  </th>

                  <th>
                    Last Purchase
                  </th>

                  <th>
                    Orders
                  </th>

                  <th>
                    Action
                  </th>

                </tr>

              </thead>

              <tbody>

                {filteredCustomers.length ===
                  0 ? (

                  <tr>

                    <td
                      colSpan="7"
                      style={{
                        textAlign:
                          "center",
                        padding:
                          "50px",
                      }}
                    >
                      <User
                        size={32}
                        style={{
                          marginBottom:
                            "10px",
                          opacity:
                            0.5,
                        }}
                      />

                      <div>
                        No customers
                        found.
                      </div>

                    </td>

                  </tr>

                ) : (

                  filteredCustomers.map(
                    (customer) => {

                      const customerId =
                        customer.customer_unique_id;

                      return (

                        <tr
                          key={
                            customerId
                          }
                        >

                          {/* CUSTOMER */}

                          <td>

                            <div className="ci-customer">

                              <div className="ci-avatar">
                                <User
                                  size={18}
                                />
                              </div>

                              <div>

                                <strong>
                                  {customerId ||
                                    "Unknown Customer"}
                                </strong>

                                <span>
                                  {customer.email ||
                                    "Customer ID"}
                                </span>

                              </div>

                            </div>

                          </td>

                          {/* CHURN PROBABILITY */}

                          <td>

                            <strong>
                              {formatProbability(
                                customer.churn_probability
                              )}
                            </strong>

                          </td>

                          {/* STATUS */}

                          <td>

                            <span
                              className={getStatusClass(
                                customer
                              )}
                            >
                              {customer.status ||
                                "Unknown"}
                            </span>

                          </td>

                          {/* LOCATION */}

                          <td>

                            {customer.customer_city ||
                              customer.customer_state ? (

                              <span>

                                {customer.customer_city ||
                                  ""}

                                {customer.customer_city &&
                                  customer.customer_state
                                  ? ", "
                                  : ""}

                                {customer.customer_state ||
                                  ""}

                              </span>

                            ) : (
                              "N/A"
                            )}

                          </td>

                          {/* LAST PURCHASE */}

                          <td>
                            {formatDate(
                              customer.last_purchase
                            )}
                          </td>

                          {/* TOTAL ORDERS */}

                          <td>
                            {customer.total_orders ??
                              0}
                          </td>

                          {/* ACTION */}

                          <td>

                            <button
                              className="ci-view-button"
                              type="button"
                              onClick={() =>
                                openCustomerDetails(
                                  customerId
                                )
                              }
                              disabled={
                                !customerId
                              }
                            >
                              View
                            </button>

                          </td>

                        </tr>

                      );
                    }
                  )

                )}

              </tbody>

            </table>

          </div>

          <div className="ci-table-pagination">
            <span>
              Showing {totalCustomers === 0 ? 0 : (page - 1) * 20 + 1}
              –{Math.min(page * 20, totalCustomers)} of {totalCustomers.toLocaleString("en-US")} predicted customers
            </span>
            <div className="ci-pagination-controls">
              <button
                type="button"
                aria-label="Previous page"
                onClick={() => setPage((currentPage) => Math.max(1, currentPage - 1))}
                disabled={loading || page <= 1}
              >
                <ChevronLeft size={17} />
              </button>
              <span>Page {totalPages === 0 ? 0 : page} of {totalPages}</span>
              <button
                type="button"
                aria-label="Next page"
                onClick={() => setPage((currentPage) => Math.min(totalPages, currentPage + 1))}
                disabled={loading || page >= totalPages}
              >
                <ChevronRight size={17} />
              </button>
            </div>
          </div>
          </>

        )}

      </div>

    </div>
  );
}

export default ChurnPrediction;
