import { useCallback, useEffect, useState } from "react";
import {
  ArrowLeft,
  Plus,
  RefreshCw,
  Search,
  UserRound,
  Pencil,
  Trash2,
  MessageSquareText,
  ClipboardList,
  RotateCcw,
} from "lucide-react";
import { useNavigate, useParams } from "react-router-dom";
import { reorder } from "../services/ordersApi";
import "../styles/ConsumerProfiles.css";

const API_PATH = "/api/v1/consumer-profiles";
const API_URL = (
  import.meta.env.VITE_API_URL || "http://127.0.0.1:8000"
).replace(/\/+$/, "");
const EMPTY_PROFILE = {
  consumer_id: "",
  name: "",
  email: "",
  phone: "",
  address: "",
  city: "",
  state: "",
  interests: [],
  notes: "",
};
function generateConsumerId() {
  return `CNS-${crypto.randomUUID().toUpperCase()}`;
}

async function request(path, options = {}) {
  const token = localStorage.getItem("access_token") || localStorage.getItem("token");
  const response = await fetch(`${API_URL}${API_PATH}${path}`, {
    ...options,
    headers: {
      "Content-Type": "application/json",
      ...(token ? { Authorization: `Bearer ${token}` } : {}),
      ...options.headers,
    },
  });
  if (response.status === 204) return null;
  const data = await response.json().catch(() => null);
  if (!response.ok) throw new Error(data?.detail || "Consumer profile request failed.");
  return data;
}

function formatDate(value) {
  if (!value) return "—";
  const date = new Date(value);
  return Number.isNaN(date.getTime())
    ? "—"
    : date.toLocaleString("en-US", { dateStyle: "medium", timeStyle: "short" });
}

function formatBRL(value) {
  const amount = Number(value);
  return Number.isFinite(amount)
    ? new Intl.NumberFormat("pt-BR", { style: "currency", currency: "BRL" }).format(amount)
    : "—";
}

function getLocationLabel(location) {
  const parts = [location?.city, location?.state].filter(Boolean);
  return parts.length ? parts.join(", ") : "—";
}

function ConsumerProfiles() {
  const navigate = useNavigate();
  const { profileId } = useParams();
  const isAdmin = (localStorage.getItem("role") || "").toLowerCase() === "admin";
  const isManager = (localStorage.getItem("role") || "").toLowerCase() === "manager";
  const [profiles, setProfiles] = useState([]);
  const [total, setTotal] = useState(0);
  const [page, setPage] = useState(1);
  const [totalPages, setTotalPages] = useState(0);
  const [searchText, setSearchText] = useState("");
  const [searchQuery, setSearchQuery] = useState("");
  const [segmentFilter, setSegmentFilter] = useState("all");
  const [interestFilter, setInterestFilter] = useState("");
  const [sortBy, setSortBy] = useState("updated_at");
  const [sortDirection, setSortDirection] = useState("desc");
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [reloadKey, setReloadKey] = useState(0);
  const [selectedProfile, setSelectedProfile] = useState(null);
  const [interactions, setInteractions] = useState([]);
  const [auditTimeline, setAuditTimeline] = useState([]);
  const [timelinePage, setTimelinePage] = useState(1);
  const [timelineTotalPages, setTimelineTotalPages] = useState(0);
  const [feedbackItems, setFeedbackItems] = useState([]);
  const [sentimentSummary, setSentimentSummary] = useState({ totals: [], daily_trend: [] });
  const [profileOrders, setProfileOrders] = useState([]);
  const [profilePredictions, setProfilePredictions] = useState([]);
  const [campaignRecommendation, setCampaignRecommendation] = useState(null);
  const [profileCustomerDetails, setProfileCustomerDetails] = useState(null);
  const [profileValueTier, setProfileValueTier] = useState(null);
  const [profileClv, setProfileClv] = useState(null);
  const [captureLoading, setCaptureLoading] = useState(false);
  const [captureError, setCaptureError] = useState("");
  const [timelineUnavailable, setTimelineUnavailable] = useState(false);
  const [reorderingId, setReorderingId] = useState("");
  const [captureNotice, setCaptureNotice] = useState("");
  const [profileModalOpen, setProfileModalOpen] = useState(false);
  const [profileModalError, setProfileModalError] = useState("");
  const [editingProfileId, setEditingProfileId] = useState(null);
  const [profileForm, setProfileForm] = useState(EMPTY_PROFILE);
  const [profileInterests, setProfileInterests] = useState("");
  const [savingProfile, setSavingProfile] = useState(false);
  const [interactionForm, setInteractionForm] = useState({
    interaction_type: "support_request",
    channel: "phone",
    subject: "",
    details: "",
  });
  const [savingCapture, setSavingCapture] = useState(false);
  useEffect(() => {
    if (profileId) return undefined;
    const controller = new AbortController();
    let current = true;
    const load = async () => {
      setLoading(true);
      setError("");
      try {
        const params = new URLSearchParams({
          page: String(page),
          limit: "20",
          search: searchQuery,
          segment: segmentFilter,
          interest: interestFilter,
          sort_by: sortBy,
          sort_direction: sortDirection,
        });
        const data = await request(`?${params.toString()}`, { signal: controller.signal });
        if (!current) return;
        setProfiles(Array.isArray(data?.profiles) ? data.profiles : []);
        setTotal(Number(data?.total) || 0);
        setTotalPages(Number(data?.total_pages) || 0);
      } catch (loadError) {
        if (loadError.name === "AbortError" || !current) return;
        setError(loadError.message || "Unable to load consumer profiles.");
        setProfiles([]);
        setTotal(0);
        setTotalPages(0);
      } finally {
        if (current) setLoading(false);
      }
    };
    load();
    return () => {
      current = false;
      controller.abort();
    };
  }, [page, searchQuery, segmentFilter, interestFilter, sortBy, sortDirection, reloadKey, profileId]);

  useEffect(() => {
    if (profileId) return undefined;
    request("/feedback-sentiment/summary")
      .then(setSentimentSummary)
      .catch((summaryError) => setError(summaryError.message || "Unable to load sentiment summary."));
    return undefined;
  }, [reloadKey, profileId]);

  const loadCaptureRecords = useCallback(async (profile) => {
    setSelectedProfile(profile);
    setCaptureNotice("");
    setProfileCustomerDetails(profile);
    setProfileValueTier(null);
    setProfileClv(null);
    setCaptureLoading(true);
    setCaptureError("");
    try {
      const [interactionResult, feedbackResult, activityResult, timelineResult] = await Promise.allSettled([
        request(`/${profile.profile_id}/interactions?limit=20`),
        request(`/${profile.profile_id}/feedback?limit=20`),
        request(`/${profile.profile_id}/activity`),
        request(`/${profile.profile_id}/timeline?page=1&limit=25`),
      ]);
      const failedCoreResults = [
        ["Interactions", interactionResult],
        ["Feedback", feedbackResult],
        ["Orders and predictions", activityResult],
      ].filter(([, result]) => result.status === "rejected");
      const interactionData = interactionResult.status === "fulfilled" ? interactionResult.value : null;
      const feedbackData = feedbackResult.status === "fulfilled" ? feedbackResult.value : null;
      const activityData = activityResult.status === "fulfilled" ? activityResult.value : null;
      const timelineData = timelineResult.status === "fulfilled" ? timelineResult.value : null;
      setCaptureError(failedCoreResults.map(([label, result]) => `${label}: ${result.reason?.message || "Unable to load."}`).join(" · "));
      setTimelineUnavailable(timelineResult.status === "rejected");
      setInteractions(Array.isArray(interactionData?.interactions) ? interactionData.interactions : []);
      setFeedbackItems(Array.isArray(feedbackData?.feedback) ? feedbackData.feedback : []);
      setProfileOrders(Array.isArray(activityData?.orders) ? activityData.orders : []);
      setProfilePredictions(Array.isArray(activityData?.predictions) ? activityData.predictions : []);
      setCampaignRecommendation(activityData?.campaign_recommendation || null);
      setAuditTimeline(Array.isArray(timelineData?.timeline) ? timelineData.timeline : []);
      setTimelinePage(1);
      setTimelineTotalPages(Number(timelineData?.total_pages) || 0);
      setProfileCustomerDetails(activityData?.customer || profile);
      setProfileValueTier(activityData?.value_tier || null);
      setProfileClv(activityData?.clv ?? null);
    } catch (loadError) {
      setCaptureError(loadError.message || "Unable to load profile activity.");
      setInteractions([]);
      setFeedbackItems([]);
      setProfileOrders([]);
      setProfilePredictions([]);
      setCampaignRecommendation(null);
      setAuditTimeline([]);
      setTimelinePage(1);
      setTimelineTotalPages(0);
      setTimelineUnavailable(false);
      setProfileCustomerDetails(profile);
      setProfileValueTier(null);
      setProfileClv(null);
    } finally {
      setCaptureLoading(false);
    }
  }, []);

  useEffect(() => {
    if (!profileId) return undefined;

    let current = true;
    const loadProfileActivity = async () => {
      setCaptureLoading(true);
      setCaptureError("");
      try {
        const profile = await request(`/${encodeURIComponent(profileId)}`);
        if (current) await loadCaptureRecords(profile);
      } catch (loadError) {
        if (current) {
          setSelectedProfile(null);
          setCaptureError(loadError.message || "Unable to load consumer profile.");
          setCaptureLoading(false);
        }
      }
    };

    loadProfileActivity();
    return () => {
      current = false;
    };
  }, [profileId, loadCaptureRecords]);

  const handleProfileReorder = async (order) => {
    if (!order?.can_reorder || !order.order_id) return;
    if (!window.confirm("Create a new unpaid order with the same items?")) return;
    setReorderingId(order.order_id);
    setCaptureError("");
    setCaptureNotice("");
    try {
      const result = await reorder(order.order_id);
      await loadCaptureRecords(selectedProfile);
      setCaptureNotice(`Reorder created: ${result.new_order_id}. Collect payment before fulfillment.`);
      setReloadKey((key) => key + 1);
    } catch (reorderError) {
      setCaptureError(reorderError.message || "Unable to create a reorder.");
    } finally {
      setReorderingId("");
    }
  };

  const loadTimelinePage = async (nextPage) => {
    if (!selectedProfile) return;
    try {
      const data = await request(`/${selectedProfile.profile_id}/timeline?page=${nextPage}&limit=25`);
      setAuditTimeline(Array.isArray(data?.timeline) ? data.timeline : []);
      setTimelinePage(Number(data?.page) || nextPage);
      setTimelineTotalPages(Number(data?.total_pages) || 0);
    } catch (timelineError) {
      setCaptureError(timelineError.message || "Unable to load customer activity timeline.");
    }
  };

  const submitSearch = (event) => {
    event.preventDefault();
    setPage(1);
    setSearchQuery(searchText.trim());
  };

  const openCreate = () => {
    setEditingProfileId(null);
    setProfileForm({ ...EMPTY_PROFILE, consumer_id: generateConsumerId() });
    setProfileInterests("");
    setSavingProfile(false);
    setProfileModalError("");
    setProfileModalOpen(true);
  };

  const openEdit = (profile) => {
    setEditingProfileId(profile.profile_id);
    setProfileForm({ ...EMPTY_PROFILE, ...profile });
    setProfileInterests((profile.interests || []).join(", "));
    setSavingProfile(false);
    setProfileModalError("");
    setProfileModalOpen(true);
  };

  const saveProfile = async (event) => {
    event.preventDefault();
    setSavingProfile(true);
    setError("");
    setProfileModalError("");
    const payload = {
      ...profileForm,
      name: (profileForm.name || "").trim(),
      email: (profileForm.email || "").trim() || null,
      phone: (profileForm.phone || "").trim() || null,
      address: (profileForm.address || "").trim() || null,
      city: (profileForm.city || "").trim() || null,
      state: (profileForm.state || "").trim() || null,
      interests: profileInterests.split(",").map((item) => item.trim()).filter(Boolean),
      notes: (profileForm.notes || "").trim() || null,
    };
    try {
      const saved = editingProfileId
        ? await request(`/${editingProfileId}`, {
          method: "PATCH",
          body: JSON.stringify(payload),
        })
        : await request("", {
          method: "POST",
          body: JSON.stringify(payload),
        });
      setProfileModalOpen(false);
      setReloadKey((key) => key + 1);
      if (saved) await loadCaptureRecords(saved);
    } catch (saveError) {
      setError(saveError.message || "Unable to save consumer profile.");
    } finally {
      setSavingProfile(false);
    }
  };

  const deleteProfile = async (profile) => {
    if (!window.confirm(`Delete the profile for ${profile.name}? Its interactions and feedback will be deleted; linked orders and audit events are retained.`)) return;
    try {
      await request(`/${profile.profile_id}`, { method: "DELETE" });
      if (selectedProfile?.profile_id === profile.profile_id) {
        setSelectedProfile(null);
        setInteractions([]);
        setFeedbackItems([]);
      }
      setReloadKey((key) => key + 1);
    } catch (deleteError) {
      setError(deleteError.message || "Unable to delete consumer profile.");
    }
  };

  const saveInteraction = async (event) => {
    event.preventDefault();
    if (!selectedProfile) return;
    setSavingCapture(true);
    setCaptureError("");
    try {
      await request(`/${selectedProfile.profile_id}/interactions`, {
        method: "POST",
        body: JSON.stringify(interactionForm),
      });
      setInteractionForm({ ...interactionForm, subject: "", details: "" });
      await loadCaptureRecords(selectedProfile);
    } catch (saveError) {
      setCaptureError(saveError.message || "Unable to save interaction.");
    } finally {
      setSavingCapture(false);
    }
  };

  return (
    <main className="consumer-profiles-page">
      <header className="consumer-profiles-header">
        <div className="consumer-profiles-title">
          <button type="button" className="consumer-back-button" onClick={() => navigate(profileId ? "/consumer-profiles" : "/customers")} aria-label={profileId ? "Back to consumer profiles" : "Back to customers"}>
            <ArrowLeft size={18} />
          </button>
          <div>
            <h1>{profileId ? "Activity & feedback" : "Consumer Profiles"}</h1>
            <p>{profileId ? "Review this customer’s details, orders, interactions, and feedback." : "Manage customer details, capture customer activity, feedback, and preferences."}</p>
          </div>
        </div>
        {!profileId && isAdmin && (
          <button type="button" className="consumer-primary-button" onClick={openCreate}>
            <Plus size={17} /> New profile
          </button>
        )}
      </header>

      {!profileId && (
        <>
      <section className="consumer-profile-toolbar">
        <form className="consumer-profile-search" onSubmit={submitSearch}>
          <Search size={17} />
          <input
            value={searchText}
            onChange={(event) => setSearchText(event.target.value)}
            placeholder="Search consumer ID, name, or email"
            aria-label="Search consumer profiles"
          />
          <button type="submit">Search</button>
        </form>
        <select aria-label="Filter customer segment" value={segmentFilter} onChange={(event) => { setPage(1); setSegmentFilter(event.target.value); }}>
          <option value="all">All segments</option>
          <option value="no-orders">No orders</option>
          <option value="first-order">First order</option>
          <option value="repeat">Repeat customer</option>
          <option value="high-value">High value (R$1,000+)</option>
          <option value="inactive">Inactive (90+ days)</option>
        </select>
        <input className="consumer-interest-filter" aria-label="Filter by interest" placeholder="Interest contains…" value={interestFilter} onChange={(event) => { setPage(1); setInterestFilter(event.target.value); }} />
        <select aria-label="Sort customer profiles" value={`${sortBy}:${sortDirection}`} onChange={(event) => { const [field, direction] = event.target.value.split(":"); setSortBy(field); setSortDirection(direction); setPage(1); }}>
          <option value="updated_at:desc">Recently updated</option>
          <option value="name:asc">Name A–Z</option>
          <option value="order_count:desc">Most orders</option>
          <option value="lifetime_spend:desc">Highest spend</option>
          <option value="last_order:desc">Latest order</option>
        </select>
        <span>{total.toLocaleString("en-US")} profiles</span>
        <button type="button" className="consumer-refresh" onClick={() => setReloadKey((key) => key + 1)} disabled={loading} aria-label="Refresh profiles">
          <RefreshCw size={16} className={loading ? "consumer-spin" : ""} />
        </button>
      </section>

      {error && <div className="consumer-error" role="alert">{error}</div>}

      <section className="consumer-sentiment-summary" aria-label="Feedback sentiment summary">
        <div className="consumer-sentiment-heading"><strong>Feedback sentiment</strong><span>Recent feedback · local keyword classification</span></div>
        <div className="consumer-sentiment-cards">
          {["positive", "neutral", "negative"].map((sentiment) => {
            const count = Number(sentimentSummary.totals?.find((item) => item.sentiment === sentiment)?.total || 0);
            return <div className={`sentiment-${sentiment}`} key={sentiment}><span>{sentiment}</span><strong>{count.toLocaleString()}</strong></div>;
          })}
        </div>
        <div className="consumer-sentiment-trend" aria-label="Daily feedback volume for the last 90 days">
          {(sentimentSummary.daily_trend || []).map((item) => <span key={`${item.date}-${item.sentiment}`} title={`${item.date}: ${item.total} ${item.sentiment} feedback`} style={{ height: `${Math.max(4, Math.min(100, Number(item.total) * 12))}%` }} className={`sentiment-${item.sentiment}`} />)}
          {!sentimentSummary.daily_trend?.length && <small>No recent feedback trend yet.</small>}
        </div>
      </section>
        </>
      )}

      <div className={`consumer-profiles-layout${profileId ? " activity-mode" : ""}`}>
        {!profileId && (
        <section className="consumer-profiles-table-panel">
          {loading ? (
            <div className="consumer-empty-state"><RefreshCw size={20} className="consumer-spin" /> Loading profiles…</div>
          ) : profiles.length === 0 ? (
            <div className="consumer-empty-state">
              <UserRound size={27} />
              <strong>{searchQuery ? "No profiles match this search" : "No consumer profiles yet"}</strong>
              <span>{searchQuery ? "Try a different name, email, phone, or ID." : "Create a profile to begin recording customer interactions and feedback."}</span>
              {!searchQuery && <button type="button" onClick={openCreate}>Create first profile</button>}
            </div>
          ) : (
            <>
              <div className="consumer-table-scroll">
                <table className="consumer-profiles-table">
                  <thead><tr><th>Consumer</th><th>Contact</th><th>Location</th><th>Orders / spend</th><th>Segments</th><th>Actions</th></tr></thead>
                  <tbody>
                    {profiles.map((profile) => (
                      <tr className={selectedProfile?.profile_id === profile.profile_id ? "selected" : ""} key={profile.profile_id}>
                        <td>
                          <strong>{profile.name}</strong>
                          <small>Consumer ID: {profile.consumer_id}</small>
                        </td>
                        <td>{profile.email || profile.phone || "—"}</td>
                        <td>{getLocationLabel(profile)}</td>
                        <td>{profile.order_count} · {formatBRL(profile.lifetime_spend)}</td>
                        <td><div className="consumer-segment-badges">{(profile.segments || []).map((segment) => <span key={segment}>{segment.replaceAll("-", " ")}</span>)}</div><small>{profile.interests?.length ? profile.interests.slice(0, 2).join(", ") : "No interests"}</small></td>
                        <td>
                          <div className="consumer-row-actions">
                            <button type="button" onClick={() => navigate(`/consumer-profiles/${encodeURIComponent(profile.profile_id)}/activity`)}>Activity</button>
                            {isAdmin && <>
                              <button type="button" onClick={() => openEdit(profile)} aria-label={`Edit ${profile.name}`}><Pencil size={14} /></button>
                              <button type="button" onClick={() => deleteProfile(profile)} aria-label={`Delete ${profile.name}`}><Trash2 size={14} /></button>
                            </>}
                          </div>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <footer className="consumer-pagination">
                <span>Page {page} of {totalPages}</span>
                <div>
                  <button type="button" onClick={() => setPage((value) => Math.max(1, value - 1))} disabled={page <= 1 || loading}>Previous</button>
                  <button type="button" onClick={() => setPage((value) => Math.min(totalPages, value + 1))} disabled={page >= totalPages || loading}>Next</button>
                </div>
              </footer>
            </>
          )}
        </section>
        )}

        {profileId && <section className="consumer-capture-panel" aria-label="Customer activity and feedback">
          {selectedProfile ? (
            <>
              <div className="consumer-selected-profile">
                <div className="consumer-selected-icon"><UserRound size={20} /></div>
                <div><h2>{selectedProfile.name}</h2><p>Consumer ID: {selectedProfile.consumer_id}{selectedProfile.email ? ` · ${selectedProfile.email}` : ""}</p></div>
              </div>
              {captureError && <div className="consumer-error" role="alert">{captureError}</div>}
              {timelineUnavailable && <div className="consumer-info" role="status">Activity timeline unavailable because the running backend has not loaded the timeline API yet. Restart the backend to enable it.</div>}
              {captureNotice && <div className="consumer-success" role="status">{captureNotice}</div>}

              <section className="consumer-capture-section">
                <h3>Customer details</h3>
                <div className="consumer-customer-details">
                  <div><span>Email</span><strong>{profileCustomerDetails?.email || "—"}</strong></div>
                  <div><span>Phone</span><strong>{profileCustomerDetails?.phone || "—"}</strong></div>
                  <div><span>Address</span><strong>{profileCustomerDetails?.address || "—"}</strong></div>
                  <div><span>Location</span><strong>{getLocationLabel(profileCustomerDetails)}</strong></div>
                  <div><span>ZIP code</span><strong>{profileCustomerDetails?.customer_zip_code_prefix || "—"}</strong></div>
                  <div><span>Interests</span><strong>{profileCustomerDetails?.interests?.join(", ") || "—"}</strong></div>
                  <div><span>Notes</span><strong>{profileCustomerDetails?.notes || "—"}</strong></div>
                  {profileCustomerDetails?.customer_unique_id && <div><span>Customer ID</span><strong>{profileCustomerDetails.customer_unique_id}</strong></div>}
                  {profileValueTier && <div><span>Value tier</span><strong>{profileValueTier}</strong></div>}
                  {profileClv !== null && <div><span>Customer lifetime value</span><strong>{formatBRL(profileClv)}</strong></div>}
                </div>
                {profileCustomerDetails?.customer_unique_id ? (
                  <button
                    className="consumer-view-details"
                    onClick={() => navigate(`/customer-details/${encodeURIComponent(profileCustomerDetails.customer_unique_id)}`)}
                    type="button"
                  >
                    View full customer details
                  </button>
                ) : (
                  <div className="consumer-details-unavailable">
                    <button className="consumer-view-details" type="button" disabled>
                      View full customer details
                    </button>
                    <span>Available after this profile is linked to a customer order.</span>
                  </div>
                )}
              </section>

              <section className="consumer-capture-section">
                <h3>Orders and churn predictions</h3>
                {captureLoading ? "Loading customer records…" : (
                  <div className="consumer-history-list">
                    {campaignRecommendation && (
                      <article className="consumer-campaign-recommendation">
                        <div>
                          <strong>Recommended campaign · {campaignRecommendation.campaign_name}</strong>
                          <span>Priority {campaignRecommendation.campaign_priority}</span>
                        </div>
                        <p>{campaignRecommendation.reason_code} · {campaignRecommendation.segment_label} · {campaignRecommendation.risk_tier}</p>
                        {campaignRecommendation.value_tier_is_provisional && (
                          <small>Provisional value tier ({campaignRecommendation.value_tier}) until CLV history is available.</small>
                        )}
                      </article>
                    )}
                    {profileOrders.length ? profileOrders.map((order) => (
                      <article key={order.order_id}>
                        <div><strong>Order · {formatBRL(order.order_amount)}</strong><time>{formatDate(order.order_purchase_timestamp)}</time></div>
                        <p>{order.order_status} · {order.order_id}</p>
                        {isManager && order.can_reorder && <button type="button" className="consumer-profile-reorder" disabled={Boolean(reorderingId)} onClick={() => handleProfileReorder(order)}>
                          <RotateCcw size={13} /> {reorderingId === order.order_id ? "Creating reorder…" : "Reorder items"}
                        </button>}
                      </article>
                    )                    ) : (
                      <p>No orders have been placed for this customer profile yet.</p>
                    )}
                    {profilePredictions.length ? profilePredictions.map((prediction) => {
                      const topFactors = Object.entries(prediction.shap_values || {})
                        .filter(([, value]) => Number.isFinite(Number(value)))
                        .sort((first, second) => Math.abs(Number(second[1])) - Math.abs(Number(first[1])))
                        .slice(0, 5);
                      return (
                        <article key={prediction.prediction_id}>
                          <div><strong>Churn probability · {(Number(prediction.churn_probability) * 100).toFixed(1)}%</strong><time>{formatDate(prediction.scored_at)}</time></div>
                          <p>Model {prediction.model_version}{prediction.order_id ? ` · Order ${prediction.order_id}` : ""}</p>
                          {(prediction.value_tier || profileValueTier) && (
                            <p>Value tier · {prediction.value_tier || profileValueTier}</p>
                          )}
                          <p>Reason codes · {prediction.reason_codes?.length ? prediction.reason_codes.join(", ") : "None returned"}</p>
                          {topFactors.length > 0 && (
                            <div className="consumer-shap-list">
                              <strong>Top SHAP contributions</strong>
                              {topFactors.map(([feature, value]) => (
                                <div key={feature}><span>{feature.replaceAll("_", " ")}</span><b>{Number(value) > 0 ? "+" : ""}{Number(value).toFixed(3)}</b></div>
                              ))}
                            </div>
                          )}
                        </article>
                      );
                    }) : <p>No churn prediction saved yet.</p>}
                  </div>
                )}
              </section>

              <section className="consumer-capture-section">
                <h3>Customer activity timeline</h3>
                <div className="consumer-history-list">
                  {captureLoading ? "Loading timeline…" : auditTimeline.length ? auditTimeline.map((event) => (
                    <article key={event.event_id}>
                      <div><strong>{event.event_type.replaceAll("_", " ")}</strong><time>{formatDate(event.occurred_at)}</time></div>
                      <p>{event.description}</p>
                      {event.actor_user_id && <small>Staff user #{event.actor_user_id}</small>}
                    </article>
                  )) : <p>No customer activity has been recorded yet.</p>}
                </div>
                {timelineTotalPages > 1 && <div className="consumer-timeline-pagination">
                  <button type="button" disabled={timelinePage <= 1 || captureLoading} onClick={() => loadTimelinePage(timelinePage - 1)}>Previous</button>
                  <span>Page {timelinePage} of {timelineTotalPages}</span>
                  <button type="button" disabled={timelinePage >= timelineTotalPages || captureLoading} onClick={() => loadTimelinePage(timelinePage + 1)}>Next</button>
                </div>}
              </section>

              <section className="consumer-capture-section">
                <h3><ClipboardList size={16} /> Log interaction</h3>
                {isAdmin && <form onSubmit={saveInteraction} className="consumer-capture-form">
                  <div className="consumer-form-grid">
                    <label>Activity type<select value={interactionForm.interaction_type} onChange={(event) => setInteractionForm({ ...interactionForm, interaction_type: event.target.value })}><option value="support_request">Support request</option><option value="sales_inquiry">Sales inquiry</option><option value="order_follow_up">Order follow-up</option><option value="complaint">Complaint</option><option value="product_question">Product question</option><option value="account_assistance">Account assistance</option><option value="other">Other activity</option></select></label>
                    <label>Channel<select value={interactionForm.channel} onChange={(event) => setInteractionForm({ ...interactionForm, channel: event.target.value })}><option value="phone">Phone</option><option value="email">Email</option><option value="in_person">In person</option><option value="web">Web</option><option value="other">Other</option></select></label>
                  </div>
                  <label>Subject<input value={interactionForm.subject} onChange={(event) => setInteractionForm({ ...interactionForm, subject: event.target.value })} maxLength={200} /></label>
                  <label>Details<textarea required rows={3} value={interactionForm.details} onChange={(event) => setInteractionForm({ ...interactionForm, details: event.target.value })} /></label>
                  <button type="submit" disabled={savingCapture}>{savingCapture ? "Saving…" : "Save interaction"}</button>
                </form>}
                <div className="consumer-history-list">
                  {captureLoading ? "Loading interaction history…" : interactions.length ? interactions.slice(0, 4).map((item) => <article key={item.interaction_id}><div><strong>{item.subject || item.interaction_type}</strong><time>{formatDate(item.occurred_at)}</time></div><p>{item.details}</p></article>) : <p>No interactions recorded yet.</p>}
                </div>
              </section>

              <section className="consumer-capture-section feedback">
                <h3><MessageSquareText size={16} /> Customer feedback</h3>
                <p className="consumer-feedback-guidance">
                  Customers can submit one rating and comment for each order after confirming delivery.
                </p>
                <div className="consumer-history-list">
                  {captureLoading ? "Loading feedback history…" : feedbackItems.length ? feedbackItems.slice(0, 4).map((item) => <article key={item.feedback_id}><div><strong>{item.rating ? `${item.rating}/5 feedback` : "Customer preferences"}{item.sentiment && <span className={`consumer-sentiment-tag sentiment-${item.sentiment}`}>{item.sentiment}</span>}</strong><time>{formatDate(item.submitted_at)}</time></div>{item.message && <p>{item.message}</p>}{item.preferences?.length > 0 && <small>Preferences: {item.preferences.join(", ")}</small>}</article>) : <p>No feedback or preferences recorded yet.</p>}
                </div>
              </section>
            </>
          ) : (
            <div className="consumer-capture-empty">
              {captureError ? <><strong>Unable to load profile activity</strong><span>{captureError}</span></> : <><RefreshCw size={20} className="consumer-spin" /><strong>Loading profile activity…</strong></>}
            </div>
          )}
        </section>}
      </div>

      {profileModalOpen && (
        <div className="consumer-modal-backdrop" role="presentation" onMouseDown={(event) => { if (event.target === event.currentTarget) setProfileModalOpen(false); }}>
          <section className="consumer-profile-modal" role="dialog" aria-modal="true" aria-labelledby="consumer-profile-modal-title">
            <header><div><h2 id="consumer-profile-modal-title">{editingProfileId ? "Edit consumer profile" : "Create consumer profile"}</h2><p>{editingProfileId ? "Update customer contact details and preferences." : "Add a customer profile. Customers place their own orders from their account."}</p></div><button type="button" onClick={() => { setSavingProfile(false); setProfileModalOpen(false); }} aria-label="Close profile form">×</button></header>
            <form onSubmit={saveProfile} className="consumer-profile-form">
              {profileModalError && <div className="consumer-error" role="alert">{profileModalError}</div>}
              <label>Consumer ID<input readOnly value={profileForm.consumer_id || "Generated when created"} /></label>
              <label>Full name<input required autoFocus value={profileForm.name} onChange={(event) => setProfileForm({ ...profileForm, name: event.target.value })} maxLength={200} /></label>
              <div className="consumer-form-grid">
                <label>Email<input type="email" value={profileForm.email || ""} onChange={(event) => setProfileForm({ ...profileForm, email: event.target.value })} /></label>
                <label>Phone<input type="tel" inputMode="numeric" maxLength={10} autoComplete="tel" placeholder="Up to 10 digits" value={profileForm.phone || ""} onChange={(event) => setProfileForm({ ...profileForm, phone: event.target.value.replace(/\D/g, "").slice(0, 10) })} /></label>
              </div>
              <label>Address<input value={profileForm.address || ""} onChange={(event) => setProfileForm({ ...profileForm, address: event.target.value })} /></label>
              <div className="consumer-form-grid">
                <label>City<input value={profileForm.city || ""} onChange={(event) => setProfileForm({ ...profileForm, city: event.target.value })} /></label>
                <label>State<input value={profileForm.state || ""} onChange={(event) => setProfileForm({ ...profileForm, state: event.target.value })} /></label>
              </div>
              <label>Interests / preferences<input value={profileInterests} onChange={(event) => setProfileInterests(event.target.value)} placeholder="e.g. electronics, delivery updates" /></label>
              <label>Notes<textarea rows={3} value={profileForm.notes || ""} onChange={(event) => setProfileForm({ ...profileForm, notes: event.target.value })} /></label>
              <footer>
                <button type="button" className="consumer-cancel" onClick={() => { setSavingProfile(false); setProfileModalOpen(false); }}>Cancel</button>
                <button type="submit" className="consumer-save" disabled={savingProfile}>{savingProfile ? "Saving…" : editingProfileId ? "Save changes" : "Create profile"}</button>
              </footer>
            </form>
          </section>
        </div>
      )}
    </main>
  );
}

export default ConsumerProfiles;
